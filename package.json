{
  "name": "dsh-web-search-searxng",
  "version": "0.2.0",
  "description": "SearXNG-backed search provider for DeepSeek Harness (DSH) web_search, configurable in chat with /searxng",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "seams": [
      "web"
    ]
  },
  "scripts": {
    "test": "node --test test/provider.test.js test/seam.test.js test/command.test.js",
    "test:local": "node --experimental-loader ./test/loader.mjs test/run-all.mjs",
    "cli": "node bin/cli.js"
  },
  "author": "nvbb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvbb/dsh-searx-plugin.git"
  },
  "homepage": "https://github.com/nvbb/dsh-searx-plugin",
  "bugs": {
    "url": "https://github.com/nvbb/dsh-searx-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "searxng",
    "search",
    "web-search",
    "plugin"
  ],
  "bin": {
    "dsh-searx": "bin/cli.js",
    "dsh-web-search-searxng": "bin/cli.js"
  }
}
